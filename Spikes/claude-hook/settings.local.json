{
  "permissions": {
    "allow": ["Bash(sleep *)", "Bash(./pause *)"]
  },
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/../spike-hook.sh", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/../spike-hook.sh", "timeout": 5 }] }],
    "PreToolUse": [{ "matcher": "Agent|Task", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/../spike-hook.sh", "timeout": 5 }] }],
    "PostToolUse": [{ "matcher": "Agent|Task", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/../spike-hook.sh", "timeout": 5 }] }],
    "PermissionRequest": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/../spike-hook.sh", "timeout": 5 }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/../spike-hook.sh", "timeout": 5 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/../spike-hook.sh", "timeout": 5 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/../spike-hook.sh", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/../spike-hook.sh", "timeout": 5 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/../spike-hook.sh", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/../spike-hook.sh", "timeout": 5 }] }]
  }
}
